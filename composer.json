{
  "name": "cloudcake/filament-themes",
  "type": "library",
  "license": "proprietary",
  "description": "Filament themes.",
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.cloudcake.sh"
    }
  ],
  "require": {
    "php": "^8.2",
    "cloudcake/filament-icons": "dev-main"
  },
  "require-dev": {
    "filament/filament": "^4.0|^5.0"
  },
  "autoload": {
    "psr-4": {
      "Cloudcake\\Themes\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cloudcake\\Themes\\ServiceProvider"
      ]
    }
  }
}
